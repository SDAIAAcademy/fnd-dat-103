{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session.schema.json",
  "title": "One charging session as the charge-point platform API returns it (version 1)",
  "type": "object",
  "required": ["session_id", "station", "started_at", "ended_at", "energy_kwh", "tariff", "amount", "account", "status", "readings"],
  "properties": {
    "session_id": {"type": "string", "pattern": "^CS-[0-9]{5}$"},
    "station": {
      "type": "object",
      "required": ["id", "sector", "connector"],
      "properties": {
        "id": {"type": "string", "pattern": "^ST[0-9]{2}$"},
        "sector": {"enum": ["North", "South", "East", "West", "Central"]},
        "connector": {"type": "string", "pattern": "^[0-9]{2}$"}
      }
    },
    "started_at": {"$ref": "#/$defs/time_with_offset"},
    "ended_at": {"$ref": "#/$defs/time_with_offset"},
    "energy_kwh": {"type": "number"},
    "tariff": {
      "type": "object",
      "required": ["code", "per_kwh"],
      "properties": {"code": {"enum": ["T1", "T2", "T3"]}, "per_kwh": {"type": "number"}}
    },
    "amount": {"type": "number"},
    "account": {"type": "string", "pattern": "^AC-K[0-9]{4}$"},
    "status": {"enum": ["completed", "stopped_by_user", "fault"]},
    "readings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["seq", "at", "kwh", "kw"],
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "at": {"$ref": "#/$defs/time_with_offset"},
          "kwh": {"type": "number"},
          "kw": {"type": "number"}
        }
      }
    }
  },
  "$defs": {
    "time_with_offset": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
